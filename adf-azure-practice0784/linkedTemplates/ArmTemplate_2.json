							"enableStaging": false,
							"translator": {
								"type": "TabularTranslator",
								"typeConversion": true,
								"typeConversionSettings": {
									"allowDataTruncation": true,
									"treatBooleanAsNumber": false
								}
							}
						},
						"inputs": [
							{
								"referenceName": "ds_AzureSQL_Source_Dynamic",
								"type": "DatasetReference",
								"parameters": {
									"TableName": {
										"value": "@pipeline().parameters.TableName",
										"type": "Expression"
									},
									"SChemaName": {
										"value": "@pipeline().parameters.SchemaName",
										"type": "Expression"
									},
									"serverName": {
										"value": "@pipeline().parameters.ServerName",
										"type": "Expression"
									},
									"DBName": {
										"value": "@pipeline().parameters.DBName",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "ds_AzureSQL_Sink_Dynamic",
								"type": "DatasetReference",
								"parameters": {
									"SourceServerName": {
										"value": "@pipeline().parameters.sourceServerName",
										"type": "Expression"
									},
									"SourceDBName": {
										"value": "@pipeline().parameters.SourceDBName",
										"type": "Expression"
									},
									"SourceTableName": {
										"value": "@pipeline().parameters.SourcetableName",
										"type": "Expression"
									},
									"SourceSchemaName": {
										"value": "@pipeline().parameters.SourceSchemaName",
										"type": "Expression"
									}
								}
							}
