			"properties": {
				"activities": [
					{
						"name": "Copy_SalesLT_Address",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.00:10:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\r\n    h.SalesOrderID,\r\n    h.OrderDate,\r\n    h.CustomerID,\r\n    h.TotalDue,\r\n    d.ProductID,\r\n    d.OrderQty,\r\n    d.UnitPrice,\r\n    d.LineTotal\r\nFROM SalesOrderHeader1 h\r\nJOIN SalesOrderDetail d\r\nON h.SalesOrderID = d.SalesOrderID;\r\n",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"sink": {
								"type": "AzureSqlSink",
								"writeBehavior": "insert",
								"sqlWriterUseTableLock": false,
								"disableMetricsCollection": false
